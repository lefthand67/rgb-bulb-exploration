{
  "name": "rgb-cups-16m-colors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive reveal.js slide deck explaining 16 million colors to 9-year-olds using RGB cups",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:web": "vite build --mode web",
    "verify:web": "node scripts/verify-web.mjs",
    "package": "npm run build:web && npm run verify:web",
    "test": "vitest run",
    "check:visuals": "node scripts/check-visuals.mjs"
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "reveal.js": "^6.0.2"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
